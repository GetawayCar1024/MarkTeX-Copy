{
  "manifest_version": 3,
  "name": "MarkTeX Copy",
  "version": "0.1.0",
  "description": "把网页内容复制为 Markdown / HTML，完整保留 KaTeX、MathJax、MathML 公式的 LaTeX 源码。",
  "permissions": [
    "contextMenus",
    "clipboardWrite",
    "storage",
    "scripting",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MarkTeX Copy",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/settings.js",
        "src/mathml2latex.js",
        "src/capture.js",
        "src/markdown.js",
        "src/html.js",
        "src/content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/main-world.js"
      ],
      "all_frames": true,
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "short_name": "MarkTeX",
  "homepage_url": "https://github.com/GetawayCar1024/marktex-copy"
}
